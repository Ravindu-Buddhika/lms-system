# Server Environment Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Connection String (Prisma format)
# Template: mysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL="mysql://lms_user:your_password_here@localhost:3306/lms_db"

# JWT Secret (for Phase 1)
JWT_SECRET="your_jwt_secret_placeholder"
JWT_EXPIRES_IN="7d"
